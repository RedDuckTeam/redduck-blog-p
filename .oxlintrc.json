{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": [
    "eslint",
    "typescript",
    "unicorn",
    "oxc",
    "import",
    "jsdoc",
    "jsx-a11y",
    "node",
    "promise",
    "vitest"
  ],
  "options": {
    "typeAware": true,
    "typeCheck": true
  },
  "ignorePatterns": ["test/**", "**/*.test.ts", "**/*.test.tsx"],
  "rules": {
    "import/no-cycle": ["error", { "maxDepth": 3 }]
  }
}
